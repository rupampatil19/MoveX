  { id: 'Kothrud',        center: [18.46, 73.80], color: '#4CAF50' },
  { id: 'Hinjewadi',      center: [18.56, 73.76], color: '#2196F3' },
  { id: 'Baner',          center: [18.64, 73.88], color: '#9C27B0' },
