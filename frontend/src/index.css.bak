@tailwind base;
@tailwind components;
@tailwind utilities;

html, body {
  overflow-x: hidden;
  background-color: #F7FAF7;
  color: #1F2D24;
}

.leaflet-container {
  background: #fff !important;
  filter: none !important;
}

.leaflet-tile-pane,
.leaflet-overlay-pane,
.leaflet-shadow-pane,
.leaflet-marker-pane,
.leaflet-tooltip-pane,
.leaflet-popup-pane {
  filter: none !important;
  opacity: 1 !important;
}

.leaflet-tile {
  filter: none !important;
  opacity: 1 !important;
}

.map-overlay,
.map-dark-overlay,
.map-shade,
.dashboard-map-overlay {
  display: none !important;
}

.reward-carousel {
  scrollbar-width: none;
  -ms-overflow-style: none;
}
.reward-carousel::-webkit-scrollbar {
  display: none;
}

/* ============================================================
   MOVEX GLASSMORPHISM SYSTEM
   ============================================================ */

.glass-page-bg {
  position: relative;
  min-height: 100vh;
  background:
    radial-gradient(at 20% 0%, rgba(37, 99, 235, 0.18) 0px, transparent 50%),
    radial-gradient(at 80% 0%, rgba(168, 85, 247, 0.14) 0px, transparent 50%),
    radial-gradient(at 80% 100%, rgba(236, 72, 153, 0.10) 0px, transparent 50%),
    radial-gradient(at 0% 100%, rgba(34, 197, 94, 0.10) 0px, transparent 50%),
    linear-gradient(135deg, #f8fafc 0%, #eef2ff 50%, #fdf4ff 100%);
  background-attachment: fixed;
}

.glass {
  background: rgba(255, 255, 255, 0.55);
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  border: 1px solid rgba(255, 255, 255, 0.7);
  box-shadow:
    0 8px 32px rgba(31, 38, 135, 0.08),
    inset 0 1px 0 rgba(255, 255, 255, 0.6);
}

.glass-strong {
  background: rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(30px) saturate(200%);
  -webkit-backdrop-filter: blur(30px) saturate(200%);
  border: 1px solid rgba(255, 255, 255, 0.85);
  box-shadow:
    0 12px 40px rgba(31, 38, 135, 0.12),
    inset 0 1px 0 rgba(255, 255, 255, 0.8);
}

.glass-subtle {
  background: rgba(255, 255, 255, 0.35);
  backdrop-filter: blur(14px) saturate(160%);
  -webkit-backdrop-filter: blur(14px) saturate(160%);
  border: 1px solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 4px 16px rgba(31, 38, 135, 0.05);
}

.glass-nav {
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(24px) saturate(200%);
  -webkit-backdrop-filter: blur(24px) saturate(200%);
  border: 1px solid rgba(255, 255, 255, 0.6);
}

.glass-input {
  background: rgba(255, 255, 255, 0.5);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(255, 255, 255, 0.6);
  transition: all 0.2s ease;
}
.glass-input:focus {
  background: rgba(255, 255, 255, 0.75);
  border-color: rgba(37, 99, 235, 0.5);
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
  outline: none;
}

@supports not (backdrop-filter: blur(10px)) {
  .glass, .glass-strong, .glass-subtle, .glass-nav {
    background: rgba(255, 255, 255, 0.9);
  }
}
