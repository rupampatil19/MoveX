  { id: 'Hadapsar',       center: [18.49, 73.94], color: '#00BCD4' },
  { id: 'Pimpri',         center: [18.66, 73.76], color: '#FF5722' },
];

// Bengaluru regions — centers adjusted so all 5 are angularly distinct
// from Bengaluru center [12.9716, 77.5946] (no overlap).
export const BENGALURU_REGIONS = [
  { id: 'Koramangala', center: [12.9352, 77.6245], color: '#4CAF50' },
  { id: 'HSR Layout',  center: [12.8950, 77.6200], color: '#FF9800' },
